# Multi-target Dockerfile for local development
# node_modules lives INSIDE the image (not mounted from host)
# src/ is mounted from host for hot reload
# Rebuild only required when package.json changes

FROM node:20-alpine AS base

# Install pnpm globally (pinned to match package.json packageManager field)
RUN npm install -g pnpm@8.15.0

WORKDIR /app

# Copy workspace configuration files first (for layer caching)
COPY pnpm-workspace.yaml turbo.json ./
COPY package.json pnpm-lock.yaml ./
COPY tsconfig.base.json ./

# Copy all package.json files to leverage layer caching
# Apps
COPY apps/bot/package.json ./apps/bot/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/

# Packages
COPY packages/database/package.json ./packages/database/
COPY packages/database/prisma ./packages/database/prisma
COPY packages/config/package.json ./packages/config/
COPY packages/queues/package.json ./packages/queues/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/storage/package.json ./packages/storage/
COPY packages/vertex-ai/package.json ./packages/vertex-ai/

# Install dependencies - node_modules stays in the image
# Native binaries (esbuild, sharp, etc.) are compiled for Linux
RUN pnpm install

# Copy package source and build packages (for dist/index.js that package.json main points to)
# This is needed because the apps import from @musicai/* workspace packages
COPY packages/config/src ./packages/config/src
COPY packages/config/tsconfig.json ./packages/config/
RUN pnpm --filter @musicai/config build

COPY packages/database/src/index.ts ./packages/database/src/index.ts
COPY packages/database/prisma ./packages/database/prisma
COPY packages/database/tsconfig.json ./packages/database/
RUN pnpm --filter @musicai/database generate
RUN pnpm --filter @musicai/database build

COPY packages/queues/src ./packages/queues/src
COPY packages/queues/tsconfig.json ./packages/queues/
RUN pnpm --filter @musicai/queues build

COPY packages/shared-types/src ./packages/shared-types/src
COPY packages/shared-types/tsconfig.json ./packages/shared-types/
RUN pnpm --filter @musicai/shared-types build

COPY packages/storage/src ./packages/storage/src
COPY packages/storage/tsconfig.json ./packages/storage/
RUN pnpm --filter @musicai/storage build

COPY packages/vertex-ai/src ./packages/vertex-ai/src
COPY packages/vertex-ai/tsconfig.json ./packages/vertex-ai/
RUN pnpm --filter @musicai/vertex-ai build

# Note: Source code is mounted from host via docker-compose volumes for hot reload
# The built dist/ files remain from this image and are used when host files reference them
# node_modules stays entirely inside the container

# ─── Target: Bot Service ──────────────────────────────────────────────────────
FROM base AS bot

CMD ["pnpm", "--filter", "@musicai/bot", "dev"]

# ─── Target: API Service ────────────────────────────────────────────────────
FROM base AS api

EXPOSE 3000

CMD ["pnpm", "--filter", "@musicai/api", "dev"]

# ─── Target: Worker Service ─────────────────────────────────────────────────
FROM base AS worker

CMD ["pnpm", "--filter", "@musicai/worker", "dev"]
