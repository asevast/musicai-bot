# Multi-target Dockerfile for local development
# node_modules lives INSIDE the image (not mounted from host)
# src/ is mounted from host for hot reload
# Rebuild only required when package.json changes

FROM node:20-alpine AS base

# Install pnpm globally (pinned to match package.json packageManager field)
RUN npm install -g pnpm@8.15.0

WORKDIR /app

# Copy workspace configuration files first (for layer caching)
COPY pnpm-workspace.yaml turbo.json ./
COPY package.json pnpm-lock.yaml ./

# Copy all package.json files to leverage layer caching
# Apps
COPY apps/bot/package.json ./apps/bot/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/

# Packages
COPY packages/database/package.json ./packages/database/
COPY packages/config/package.json ./packages/config/
COPY packages/queues/package.json ./packages/queues/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/storage/package.json ./packages/storage/
COPY packages/vertex-ai/package.json ./packages/vertex-ai/

# Install dependencies - node_modules stays in the image
# Native binaries (esbuild, sharp, etc.) are compiled for Linux
RUN pnpm install

# Generate Prisma client with Linux binaries (these are needed at runtime)
# The binary targets include both native and linux-musl-openssl-3.0.x for Alpine
RUN pnpm --filter @musicai/database generate

# Note: Source code is NOT copied here - it's mounted from host via docker-compose volumes
# This enables hot reload while keeping node_modules inside the container
# However, the Prisma generated client stays in the image (see volumes in docker-compose.yml)

# ─── Target: Bot Service ──────────────────────────────────────────────────────
FROM base AS bot

CMD ["pnpm", "--filter", "@musicai/bot", "dev"]

# ─── Target: API Service ────────────────────────────────────────────────────
FROM base AS api

EXPOSE 3000

CMD ["pnpm", "--filter", "@musicai/api", "dev"]

# ─── Target: Worker Service ─────────────────────────────────────────────────
FROM base AS worker

CMD ["pnpm", "--filter", "@musicai/worker", "dev"]
