# =============================================================================
# .env.development - Docker Compose Environment
# =============================================================================
# This file is used when running services in Docker containers via docker-compose.
# Use .env (in repo root) for host-based development.
#
# Key differences from .env:
# - DATABASE_URL/REDIS_URL use Docker service names (postgres, redis) not localhost
# - Storage uses STORAGE_* vars (MinIO) instead of GCS_* vars
# - All services communicate via Docker internal network
# =============================================================================

# App
NODE_ENV=development
PORT=3000
API_URL=http://api:3000

# Telegram (set your real bot token here)
BOT_TOKEN=8774093729:AAEKh6o0eJ7reupoEBVoWssD6DLs704CUjE
TELEGRAM_CHAT_ID=8774093729 #7317629990
WEBHOOK_URL=
WEBHOOK_SECRET=musicai_secret_2024

# Google Cloud (only for Vertex AI - storage uses MinIO in dev)
GOOGLE_CLOUD_PROJECT=musicai-bot
VERTEX_AI_LOCATION=us-central1
# Set this to path to your service account JSON inside the container
GOOGLE_APPLICATION_CREDENTIALS=/app/infra/service-account.json

# Storage - MinIO (S3-compatible) for local development
# In production, these are not used - GCS with Application Default Credentials
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=musicai-tracks-dev
STORAGE_PUBLIC_URL=http://localhost:9000/musicai-tracks-dev

# Lyria API (via routerai.ru)
LYRIA_API_KEY=sk-adQTDrUbCMCGJ-RawRb3sddaQfr3c5_I
LYRIA_BASE_URL=https://routerai.ru/api/v1

# Database - uses Docker service name, not localhost
# Containers communicate via internal Docker network
# Password matches existing postgres_data volume (originally set with Gang26)
DATABASE_URL=postgresql://musicai:Gang26@postgres:5432/musicai
DIRECT_DATABASE_URL=postgresql://musicai:Gang26@postgres:5432/musicai

# Supabase (optional - can be disabled in dev)
# Leave empty or unset to disable Supabase integration
# SUPABASE_URL=http://localhost
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Redis - uses Docker service name, not localhost
# Password matches existing redis_data volume (originally set with Seor#26)
REDIS_URL=redis://:Seor#26@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Seor#26

# MinIO (legacy vars - kept for backward compatibility, prefer STORAGE_*)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=musicai-tracks-dev

# Payments (optional in dev)
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Limits
FREE_DAILY_TRACKS_LIMIT=3
PRO_DAILY_TRACKS_LIMIT=20
MAX_PROMPT_LENGTH=1000
MAX_LYRICS_LENGTH=2000

# Rate limiting
GENERATE_RATE_LIMIT_PER_MIN=5
COMMAND_RATE_LIMIT_PER_MIN=30
