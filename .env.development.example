# =============================================================================
# .env.development.example - Docker Compose Environment Template
# =============================================================================
# Copy this file to .env.development and fill in your real values:
#   cp .env.development.example .env.development
#
# ⚠️ NEVER commit .env.development with real secrets!
# This file is safe to commit (it only contains placeholders).
# =============================================================================

# App
NODE_ENV=development
PORT=3000
API_URL=http://api:3000

# Telegram (get your token from @BotFather)
BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
WEBHOOK_URL=
WEBHOOK_SECRET=your-secure-random-secret-here

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/app/infra/service-account.json

# Storage - MinIO
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=musicai-tracks-dev
STORAGE_PUBLIC_URL=http://localhost:9000/musicai-tracks-dev

# Lyria API
LYRIA_API_KEY=your-lyria-api-key-here
LYRIA_BASE_URL=https://routerai.ru/api/v1

# Database
DATABASE_URL=postgresql://musicai:your-db-password@postgres:5432/musicai
DIRECT_DATABASE_URL=postgresql://musicai:your-db-password@postgres:5432/musicai

# Redis
REDIS_URL=redis://:your-redis-password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# MinIO (legacy)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=musicai-tracks-dev

# Payments (optional)
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Limits
FREE_DAILY_TRACKS_LIMIT=3
PRO_DAILY_TRACKS_LIMIT=20
MAX_PROMPT_LENGTH=1000
MAX_LYRICS_LENGTH=2000

# Rate limiting
GENERATE_RATE_LIMIT_PER_MIN=5
COMMAND_RATE_LIMIT_PER_MIN=30
