# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Telegram
BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=
WEBHOOK_SECRET=

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=musicai-tracks
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/musicai-tracks

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musicai
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musicai

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Payments
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Limits
FREE_DAILY_TRACKS_LIMIT=3
PRO_DAILY_TRACKS_LIMIT=20
MAX_PROMPT_LENGTH=1000
MAX_LYRICS_LENGTH=2000

# Rate limiting
GENERATE_RATE_LIMIT_PER_MIN=5
COMMAND_RATE_LIMIT_PER_MIN=30
EOF